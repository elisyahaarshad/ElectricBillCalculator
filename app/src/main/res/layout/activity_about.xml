<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:scrollbars="vertical"
    android:background="#F4F7FB"
    android:overScrollMode="always">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About Application"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/electric_logo"
            android:contentDescription="Electric Bill Calculator Logo"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Electric Bill Calculator"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Version 1.0"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Application Description"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#17365D"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This application helps users calculate their monthly electricity bills based on electricity consumption and rebate percentage. Users can calculate, save, view, edit and delete their bill records."
            android:textSize="16sp"
            android:textColor="#334155"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Developer Information"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#17365D"/>

        <ImageView
            android:id="@+id/imgStudent"
            android:layout_width="150dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/elisyah"
            android:contentDescription="Student Profile Picture"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvDeveloper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Name: NURUL ELISYAH BT MUHAMMAD ARSHAD&#10;Student ID: 2022726869 ID&#10;Course: ICT602&#10;Course Name: Mobile Technology"
            android:textSize="16sp"
            android:textColor="#334155"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to Use the Application"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#17365D"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Select the desired month.&#10;2. Enter electricity usage (1–1000 kWh).&#10;3. Select rebate percentage (0%–5%).&#10;4. Tap Calculate Bill to view the result.&#10;5. Tap View Bill History to view saved records.&#10;6. Select a record to view, edit or delete it."
            android:textSize="16sp"
            android:textColor="#334155"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copyright © 2026 Electric Bill Calculator. All rights reserved."
            android:textSize="12sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="BACK TO HOME"
            android:backgroundTint="#17365D"/>

    </LinearLayout>
</ScrollView>
